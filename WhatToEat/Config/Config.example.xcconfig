//
// Config.example.xcconfig
// WhatToEat
//
// ⚠️ 使用说明：
// 1. 复制此文件为 Config.xcconfig
// 2. 填入你的真实API Key替换所有的 YOUR_XXX_HERE
// 3. 确保Config.xcconfig不会被提交到Git（已在.gitignore中）
//
// 此文件可以安全地提交到Git，因为它不包含真实密钥。
//

// ==========================================
// 应用后端代理配置
// 生产环境必须由自有后端代理第三方 AI / 运势接口
// ==========================================
URL_SLASH = /
BACKEND_BASE_URL = https:$(URL_SLASH)$(URL_SLASH)api.example.com
BACKEND_PROXY_TOKEN = YOUR_PROXY_TOKEN_HERE

// ==========================================
// 可选：自定义路径，不填则使用应用内默认值
// ==========================================
BACKEND_AI_FORTUNE_PATH = /v1/food-fortune/generate
BACKEND_FORTUNE_LUNAR_PATH = /v1/fortune/lunar
BACKEND_FORTUNE_CONSTELLATION_PATH = /v1/fortune/constellation
